        "#função para calcular o desconto\n",
        "def calcular_desconto(preco, percentual):\n",
        "    desconto = preco * (percentual / 100)\n",
        "    preco_com_desconto = preco - desconto\n",
        "    return preco_com_desconto\n",
        "\n",
        "\n",
        "#funçao para calcular quannto sera o percentual de desconto\n",
        "def calcular_percentual_desconto(preco):\n",
        "    if preco >= 1000:\n",
        "        return 15\n",
        "    elif preco >= 500:\n",
        "        return 10\n",
        "    else:\n",
        "        return 5\n",
        "#lista de dicionario para que eu possa acessar\n",
        "produtos = [\n",
